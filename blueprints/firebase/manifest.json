{
  "kind": "base",
  "slug": "firebase",
  "title": "Firebase",
  "version": "0.1.0",
  "description": "Firebase Hosting + Authentication + Firestore + Cloud Functions, with separate dev and production projects.",
  "platform": "firebase",
  "requires": [
    {
      "command": "node",
      "probe": "node --version",
      "installHint": "https://nodejs.org/"
    },
    {
      "command": "yarn",
      "probe": "yarn --version",
      "installHint": "corepack enable"
    },
    {
      "command": "firebase",
      "probe": "firebase --version",
      "installHint": "yarn global add firebase-tools"
    },
    {
      "command": "gcloud",
      "probe": "gcloud --version",
      "installHint": "https://cloud.google.com/sdk/docs/install"
    },
    {
      "command": "java",
      "probe": "java -version",
      "installHint": "The Firestore emulator needs a JDK (11 or later)."
    }
  ],
  "credentials": ["firebase login", "gcloud auth login"]
}
