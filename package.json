{
  "name": "mulmoterminal",
  "version": "9.6.0",
  "description": "Run multiple Claude Code and Codex sessions in parallel — a browser terminal grid that shows which agent needs you. Local, tmux-backed.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/mulmoterminal.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "agentic-coding",
    "vibe-coding",
    "terminal",
    "parallel-agents",
    "tmux",
    "git-worktree",
    "xterm",
    "mulmoterminal",
    "claude"
  ],
  "bin": {
    "mulmoterminal": "bin/mulmoterminal.js",
    "claude-ollama": "bin/claude-ollama.js"
  },
  "files": [
    "bin/",
    "common/",
    "dist/",
    "server/",
    "plugins/",
    "blueprints/",
    "docs/guide/en/v*.md",
    "docs/guide/ja/v*.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"node scripts/dev-server.mjs\" \"vite\"",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:client": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --cache --cache-strategy metadata --concurrency auto --format ./scripts/eslint-formatter-summary.mjs",
    "lint:ci": "eslint . --cache --cache-strategy content --format ./scripts/eslint-formatter-summary.mjs",
    "lint:summary": "eslint . --format json | node scripts/lint-summary.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "preview": "vite preview",
    "server": "node --import tsx --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "prepack": "vue-tsc -b && vite build",
    "postinstall": "node server/fix-pty-perms.js"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@google/genai": "^2.28.0",
    "@gui-chat-plugin/jinglescript": "^0.6.0",
    "@gui-chat-plugin/shapescript": "^8.2.2",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mulmobridge/web-push": "^1.1.0",
    "@mulmocast/beat-editor": "^1.1.1",
    "@mulmocast/deck": "^2.0.2",
    "@mulmocast/types": "^2.19.0",
    "@mulmochat-plugin/generate-image": "^2.0.0",
    "@mulmochat-plugin/ui-image": "^0.4.1",
    "@mulmoclaude/accounting-plugin": "^4.0.2",
    "@mulmoclaude/chart-plugin": "^4.0.1",
    "@mulmoclaude/collection-plugin": "^5.5.0",
    "@mulmoclaude/core": "^5.11.2",
    "@mulmoclaude/form-plugin": "^2.1.0",
    "@mulmoclaude/google-plugin": "^4.1.0",
    "@mulmoclaude/html-plugin": "^5.0.1",
    "@mulmoclaude/markdown-plugin": "^5.2.0",
    "@mulmoclaude/markdown-utils": "^3.0.1",
    "@mulmoclaude/mulmoscript-plugin": "^5.3.0",
    "@mulmoclaude/x-plugin": "^1.0.4",
    "@receptron/sharedapp": "^0.47.0",
    "@receptron/task-scheduler": "^1.0.3",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "codemirror-json-schema": "^0.8.1",
    "content-disposition": "^3.0.0",
    "dompurify": "^3.4.16",
    "echarts": "^6.0.0",
    "express": "^5.3.0",
    "firebase": "12.19.0",
    "graphai": "^2.0.18",
    "gui-chat-protocol": "^2.3.0",
    "jinglescript": "^0.6.0",
    "marked": "^18.1.0",
    "material-symbols": "^0.47.6",
    "mulmocast": "^2.19.0",
    "node-pty": "1.2.0-beta.15",
    "puppeteer": "^25.13.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "uqr": "^0.1.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "knip": "6.41.0",
    "light-my-request": "^6.6.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "homepage": "https://receptron.github.io/mulmoterminal/",
  "resolutions": {
    "@xmldom/xmldom": "^0.9.12",
    "lodash-es": "^4.18.1",
    "undici": "^7.29.1",
    "@grpc/grpc-js": "^1.14.6"
  }
}
